# PerfectPixel — example API key environment variables
# Copy this file to .env or .env.local and fill in only the keys for the providers you use.
# (You can also enter them directly in the in-app settings screen. The settings file takes precedence over environment variables.)
#
# .env / .env.local are excluded from commits by .gitignore.

# Gemini (Google AI Studio) — default provider
GEMINI_API_KEY=
# GOOGLE_API_KEY is also recognized as a fallback.

# OpenAI (GPT Image 2)
OPENAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# fal.ai
FAL_KEY=
# FAL_API_KEY is also recognized as a fallback.

# BytePlus (ARK)
BYTEPLUS_API_KEY=
# ARK_API_KEY is also recognized as a fallback.
